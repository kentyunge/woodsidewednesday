# --- Database ---------------------------------------------------------------
# Production: Neon Postgres connection string (use the *pooled* URL).
# Local dev: leave unset to use an embedded PGlite database in ./.pglite
# DATABASE_URL=postgres://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (http://localhost:3000 locally, https://your-app.vercel.app in production)
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated emails that become league administrators when they first sign in
ADMIN_EMAILS=kent.yunge@gmail.com

# --- Email (magic links) ----------------------------------------------------
# Without a key, sign-in links are printed to the server console (handy locally).
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Woodside Wednesday <league@yourdomain.com>"

# --- League -----------------------------------------------------------------
# Used to decide "today" for score-entry locks
NEXT_PUBLIC_LEAGUE_TIMEZONE=America/Chicago

# --- Weekly recap (Claude) --------------------------------------------------
# Anthropic API key used to write the weekly recap email (console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-...
# Who recaps go to: unset = admins only (for testing the tone); "league" = every regular with an email, plus admins
# RECAP_SEND_TO=league
